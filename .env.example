# TelegramWebDAV 环境变量模板（复制为 .env 并填写真实值）

# ---------- Telegram 存储（必填其一） ----------
# 单 bot 模式：
TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_CHAT_ID=-1001234567890
#   公开频道可用 @channelname；私有频道/群组用 -100xxxx（转发给 @JsonViewBot 查 chat.id）

# 多 bot 池（可选，分摊 1 msg/s 流控；未填则回退上面的单 bot）
# 每项可带可选的 apiBase / proxyToken，单独覆盖该 bot 的 API 代理与鉴权：
# TG_BOT_POOLS=[{"token":"111:AAA","chatId":"-100xxx"},
#               {"token":"222:BBB","chatId":"-100yyy","apiBase":["https://p1/tg","https://p2/tg"],"proxyToken":"tok2"}]
#   - apiBase 写成数组 = 该 bot 走多个 TG 代理（请求级轮询 + 失败自动切换）
#   - apiBase / proxyToken 缺省时回退到下面全局的 TG_API_BASE / TG_PROXY_TOKEN

# 自建 Telegram API 代理（国内/被墙环境可选，留空直连 api.telegram.org）
# 作为各 bot 未单独指定 apiBase 时的默认回退
# TG_API_BASE=https://你的代理域名/tg
#   若该代理额外要求鉴权（自建网关 / Cloudflare 前置等），填下面这个令牌；
#   服务会为每个请求带上 Authorization: Bearer <token>。官方 API 场景留空即可。
#   作为各 bot 未单独指定 proxyToken 时的默认回退。
# TG_PROXY_TOKEN=你的代理访问令牌

# 全局代理候选池（所有 bot 共享的多个 TG 代理）：字符串数组或对象数组
# TG_PROXY_POOLS=["https://p1/tg","https://p2/tg"]
# TG_PROXY_POOLS=[{"apiBase":"https://p1/tg","proxyToken":"t1"},{"apiBase":"https://p2/tg","proxyToken":"t2"}]

# 上传/下载并发（0=自动，上传=bot 数，下载=min(分片数,bot 数,8)）
# TG_UPLOAD_CONCURRENCY=0
# TG_DOWNLOAD_CONCURRENCY=0

# ---------- WebDAV 认证（建议必填） ----------
DAV_USER=admin
DAV_PASSWORD=change-me

# ---------- 服务参数 ----------
DB_PATH=./telegram_webdav.db
CHUNK_SIZE_MB=20
HOST=0.0.0.0
PORT=8080
TG_RATE_LIMIT=1.0
DAV_ROOT=/

# ---------- 健壮性（可选，一般无需改动） ----------
# keep-alive 复用连接：默认 on。若某 WebDAV 客户端（尤其是某些 AList/OpenList 版本）
# 仍报 `malformed HTTP status code "HTML>"`，说明它的请求体长度数错导致连接错位，
# 设 off 退回「每条连接只服务一次」的保守模式即可。
# DAV_KEEPALIVE=on
# 请求体读取超时（秒）：Content-Length 虚高时避免线程被拖死，默认 300。
# DAV_BODY_TIMEOUT=300
# keep-alive 空闲等待上限（秒）：超时回收空闲连接，默认 30；自测可设小。
# DAV_IDLE_TIMEOUT=30

# ---------- 频道自动入库 Webhook（可选） ----------
# TG_WEBHOOK_SECRET=你的随机密钥
# WEBDAV_IMPORT_DIR=/telegram-import
