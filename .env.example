# TelegramWebDAV 环境变量模板（复制为 .env 并填写真实值）

# ---------- Telegram 存储（必填其一） ----------
# 单 bot 模式：
TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_CHAT_ID=-1001234567890
#   公开频道可用 @channelname；私有频道/群组用 -100xxxx（转发给 @JsonViewBot 查 chat.id）

# 多 bot 池（可选，分摊 1 msg/s 流控；未填则回退上面的单 bot）
# 每项可带可选的 apiBase / proxyToken，单独覆盖该 bot 的 API 代理与鉴权：
# TG_BOT_POOLS=[{"token":"111:AAA","chatId":"-100xxx"},
#               {"token":"222:BBB","chatId":"-100yyy","apiBase":["https://p1/tg","https://p2/tg"],"proxyToken":"tok2"}]
#   - apiBase 写成数组 = 该 bot 走多个 TG 代理（请求级轮询 + 失败自动切换）
#   - apiBase / proxyToken 缺省时回退到下面全局的 TG_API_BASE / TG_PROXY_TOKEN

# 自建 Telegram API 代理（国内/被墙环境可选，留空直连 api.telegram.org）
# 作为各 bot 未单独指定 apiBase 时的默认回退
# TG_API_BASE=https://你的代理域名/tg
#   若该代理额外要求鉴权（自建网关 / Cloudflare 前置等），填下面这个令牌；
#   服务会为每个请求带上 Authorization: Bearer <token>。官方 API 场景留空即可。
#   作为各 bot 未单独指定 proxyToken 时的默认回退。
# TG_PROXY_TOKEN=你的代理访问令牌

# 全局代理候选池（所有 bot 共享的多个 TG 代理）：字符串数组或对象数组
# TG_PROXY_POOLS=["https://p1/tg","https://p2/tg"]
# TG_PROXY_POOLS=[{"apiBase":"https://p1/tg","proxyToken":"t1"},{"apiBase":"https://p2/tg","proxyToken":"t2"}]

# ---------- 代理 / 优选 IP 负载均衡（默认关闭 = 现有「按序主备 + 失败切换」） ----------
# 关闭时本功能对行为**零影响**：候选不做 IP 展开、顺序 = 配置顺序、不记账、不改连接池。
# TG_PROXY_LB=off
#
# 开启后要把「域名 → 优选 IP」映射给它。实现是 TCP 连指定 IP、SNI/Host 仍用原域名
# （Cloudflare Pages/Workers 按 SNI 路由，所以这样能正确落到同一个项目上）：
# TG_PROXY_IPS=tg-proxy-b4t.pages.dev=155.117.224.63;otterhub-tg-proxy-3uj.pages.dev=43.175.131.30;tg.totootao.top=209.33.166.199
#   也可以只给一串 IP（对所有代理域名生效）：TG_PROXY_IPS=1.2.3.4,5.6.7.8
#
# 四种模式：
#   off      —— 默认。「按序主备 + 失败切换」，与不开时完全一致。
#   fastest  —— 选 EWMA 吞吐最高的健康路由（推荐）。实测同一批 CF 优选 IP 单车道能差 20 倍，
#               择优收益最大；带「在途惩罚」，并发时会自动铺开到次快车道，不会全挤一条。
#   weighted —— 按 EWMA 吞吐加权随机，多车道并发时最平滑。
#   rr       —— 严格轮询。**只在几个 IP 速度差不多时用**：速度不均时它会把请求均分到慢 IP 上
#               （实测慢 IP 能让单个分片从 3s 涨到 70s）。
# 可选微调（都有默认值，一般不用动）：
#   TG_PROXY_LB_PENALTY=0.5       在途惩罚系数：score = 吞吐 / (1 + 在途数 × 系数)；0=不惩罚
#   TG_PROXY_LB_EXPLORE=0.1       ε-greedy 探索概率（让没测过的路由也有机会被采样）；0=完全贪心
#   TG_PROXY_LB_ALPHA=0.3         EWMA 平滑系数，越大越跟手、越小越稳
#   TG_PROXY_LB_FAILS=3           连续失败几次后把该路由踢进冷却
#   TG_PROXY_LB_COOLDOWN=60       首次冷却秒数（之后指数退避，上限 TG_PROXY_LB_COOLDOWN_MAX=300）
#   TG_PROXY_LB_KEEP_DNS=on       是否保留「走 DNS 解析」的兜底路由（优选 IP 全挂时还有退路）
#   TG_PROXY_LB_MIN_BYTES=262144  小于此体积的请求不参与吞吐统计（getFile 只有几百字节，
#                                 一次 RTT 抖动就能算出「几百 B/s」，会误杀好路由）
#   TG_PROXY_LB_LOG_EVERY=100     每多少次选路打一条路由统计日志（排查「为啥总走这个 IP」）

# 上传/下载并发（0=自动，上传=bot 数，下载=min(分片数,bot 数,8)）
# TG_UPLOAD_CONCURRENCY=0
# TG_DOWNLOAD_CONCURRENCY=0

# 上传在飞分片上限（0=默认 并发数+2）：限制流式上传的内存占用，实际内存 ≈ 在飞数×分片大小。
# 内存受限的小内存 VPS 可调小（如 4 → 约 80MB），代价是上传吞吐可能下降。
# TG_UPLOAD_INFLIGHT=0

# sendDocument 单请求 socket 超时秒数（默认 60，原 240）：兜住代理/TG 侧「挂起不响应」
# 的分片——实测挂起可达 246s 并阻塞同 bot 后续分片；到点即换代理/换 bot 重传。
# 慢速但持续出字节的链路不受影响。跨洋高延迟环境如频繁误杀可调大。
# TG_HTTP_TIMEOUT=60

# ---------- WebDAV 认证（建议必填） ----------
DAV_USER=admin
DAV_PASSWORD=change-me

# ---------- 服务参数 ----------
DB_PATH=./telegram_webdav.db
CHUNK_SIZE_MB=20
HOST=0.0.0.0
PORT=8080
TG_RATE_LIMIT=1.0
DAV_ROOT=/

# ---------- 健壮性（可选，一般无需改动） ----------
# keep-alive 复用连接：默认 on。若某 WebDAV 客户端（尤其是某些 AList/OpenList 版本）
# 仍报 `malformed HTTP status code "HTML>"`，说明它的请求体长度数错导致连接错位，
# 设 off 退回「每条连接只服务一次」的保守模式即可。
# DAV_KEEPALIVE=on
# 请求体读取超时（秒）：Content-Length 虚高时避免线程被拖死，默认 300。
# DAV_BODY_TIMEOUT=300
# keep-alive 空闲等待上限（秒）：超时回收空闲连接，默认 30；自测可设小。
# DAV_IDLE_TIMEOUT=30

# ---------- 频道自动入库 Webhook（可选） ----------
# TG_WEBHOOK_SECRET=你的随机密钥
# WEBDAV_IMPORT_DIR=/telegram-import
